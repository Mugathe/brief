# ---- Supabase (Project Settings -> API) ----
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-public-key
VITE_SUPABASE_PROJECT_ID=YOUR-PROJECT-REF
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-anon-public-key
SUPABASE_PROJECT_ID=YOUR-PROJECT-REF

# ---- Server-only secrets: never commit, never expose in the browser ----
# Lets the server save the news history archive (Trending and Trails need this).
SUPABASE_SERVICE_ROLE_KEY=
# Any long random text. A free cron service calls /api/public/ingest with it so history keeps growing.
INGEST_KEY=

# ---- Your public address, used in WhatsApp share links ----
VITE_SITE_URL=http://localhost:8080

# ---- Daily brief writer (optional; without a key it shows grouped headlines) ----
ANTHROPIC_API_KEY=
# Listen-to-the-brief audio (optional)
ELEVENLABS_API_KEY=

# ---- Security (two-factor) ----
# Staff must verify an authenticator app code. Set to false ONLY briefly while first setting up, then remove.
# VITE_REQUIRE_MFA=false
# Hide the Google button until Google sign-in is configured.
# VITE_GOOGLE_SIGNIN=false

# ---- Security alerts: every channel is optional ----
# Email via resend.com. Until you verify your own domain, Resend only delivers to the address you registered with.
RESEND_API_KEY=
ALERT_EMAILS=you@example.com, deputy@example.com
ALERT_FROM=Brief Alerts <onboarding@resend.dev>
# SMS via africastalking.com (critical alerts only). AT_ENV=sandbox for testing, live for real messages.
AT_USERNAME=
AT_API_KEY=
AT_ENV=sandbox
AT_SENDER_ID=
ALERT_SMS=+254700000000, +254711000000
# Telegram (free): create a bot with @BotFather, then add the bot to a chat.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- Legal pages (Terms, Privacy, Editorial). Shown publicly; have a Kenyan advocate review the wording. ----
VITE_BRAND_NAME=Brief
# Which edition visitors see first: "world" (default) or a country code such as KE, NG, ZA, GB, US, IN.
VITE_DEFAULT_EDITION=world
VITE_LEGAL_NAME=
VITE_LEGAL_ADDRESS=
VITE_CONTACT_EMAIL=

# ---- AI research agent (optional) ----
# Needs ANTHROPIC_API_KEY above and SUPABASE_SERVICE_ROLE_KEY. Web search must be enabled for your Anthropic organisation.
# TRAIL_AGENT_MODEL=claude-haiku-4-5-20251001
# TRAIL_AGENT_DAILY_LIMIT=25
# TRAIL_AGENT_VISITOR_DAILY_LIMIT=15

# ---- Bulletin audio ----
# Studio voices (optional). Without it the Play button uses the browser's built-in voice.
# ELEVENLABS_API_KEY=
# Set if you run more than one server instance, so every instance accepts the same signed audio lines.
# AUDIO_SIGNING_KEY=
# Model that writes the bulletin when ANTHROPIC_API_KEY is set.
# BRIEF_MODEL=claude-haiku-4-5-20251001

# ---- Bulletin voice: Kenyan accent ----
# Microsoft Azure Speech has real Kenyan-English voices (Asilia, Chilemba). Free tier available.
# AZURE_SPEECH_KEY=
# AZURE_SPEECH_REGION=southafricanorth
# AZURE_VOICE_AMANI=en-KE-AsiliaNeural
# AZURE_VOICE_BARAKA=en-KE-ChilembaNeural
# ElevenLabs alternative: choose Kenyan voices from its Voice Library and paste their Voice IDs.
# ELEVENLABS_VOICE_AMANI=
# ELEVENLABS_VOICE_BARAKA=
# ELEVENLABS_MODEL=eleven_multilingual_v2
# TTS_PROVIDER=azure

# ---- Live trending from YouTube and X (both optional; without a key that list is simply left out) ----
# YouTube Data API v3 key (free quota): Google Cloud console -> APIs -> YouTube Data API v3 -> Credentials.
YOUTUBE_API_KEY=
# X API bearer token with access to the trends endpoint (X charges for this; see developer.x.com for current pricing).
X_BEARER_TOKEN=
# How long X results are reused before asking again, in minutes (minimum 10). Each ask can cost money.
X_TRENDS_TTL_MINUTES=60

# ---- Voices per language (optional) ----
# Override any default Azure voice, for example the Kiswahili (Kenya) woman's voice:
# AZURE_VOICE_SW_KE_AMANI=sw-KE-ZuriNeural
# Pattern: AZURE_VOICE_<LANG>_<COUNTRY>_<AMANI|BARAKA>. AMANI is the woman's voice, BARAKA the man's.

# ---- Running on your own server (npm run build:node, then npm start) ----
# Where the server listens. Keep 127.0.0.1 and put Caddy or Nginx in front; use 0.0.0.0 only inside a container.
PORT=3000
HOST=127.0.0.1
# npm start refreshes every edition and saves the headlines this often, in minutes (needs INGEST_KEY). 0 turns it off.
INGEST_EVERY_MINUTES=20

# Studio: posting reels and pictures to Brief's own accounts (all optional; see SETUP.md section 13).
# These are secrets on the server (Cloudflare), never VITE_ values.
# FACEBOOK_PAGE_ID=
# FACEBOOK_PAGE_TOKEN=
# FACEBOOK_GRAPH_VERSION=v26.0
# YOUTUBE_CLIENT_ID=
# YOUTUBE_CLIENT_SECRET=
# YOUTUBE_REFRESH_TOKEN=
